PORT=8080
SQLITE_FILE=./data/app.sqlite

MAILER_MODE=dev
MAIL_FROM="Warm Memories <no-reply@warmmemories.local>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=secret

GEN_API_KEY=your_gen_api_key
GEN_API_BASE_URL=https://gen-api.ru

JWT_ACCESS_SECRET=dev_secret
JWT_ACCESS_TTL=15m

ADMIN_TOKEN=admin-secret

GENAPI_BASE_URL=https://api.gen-api.ru
GENAPI_API_KEY=your_genapi_key
GENAPI_MODEL_ID=kling-video-2-6
GENAPI_CALLBACK_SECRET=change_me
APP_PUBLIC_BASE_URL=http://localhost:8080

# YooKassa (payments)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=http://localhost:5173/billing/return
YOOKASSA_API_BASE=https://api.yookassa.ru
YOOKASSA_TEST_MODE=true

# Uploads
UPLOAD_MAX_BYTES=8000000
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

ALLOWED_ORIGINS=http://localhost:5173